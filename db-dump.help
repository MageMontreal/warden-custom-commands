#!/usr/bin/env bash
[[ ! ${WARDEN_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1

WARDEN_USAGE=$(cat <<EOF
Dump remote database and download it locally. By default, customers, orders and temporary tables are excluded.

\033[33mUsage:\033[0m
  db-dump [-h|--help] [-e|--environment=<environment>] [-f|--file=<file>] [-c|--include-customer-data] [-d|--full]

\033[33mOptions:\033[0m
  -h, --help                   Display this help menu

\033[33mArguments:\033[0m
  -f, --file=<file>            Output file.

  -c, --include-customer-data  Include customer data (but not order data)

  -o, --include-order-data     Include order data and customer data

  -d, --full                   Full dump, no tables or data are excluded

  -i, --import                 Import the database after dump

  --no-anonymize               Disable automatic PII anonymization.
                               By default, when customer or order data is
                               included (-c, -o, or -d), the dump is
                               automatically anonymized.

  -e, --environment=<dev|production|staging>  Specific environment to run a database backup from. Default: staging

\033[33mAnonymization:\033[0m
  Table exclusions and PII anonymization are configured via YAML:
    Default:  ~/.warden/commands/anonymize.yaml
    Project:  .warden/anonymize.yaml (extends/overrides default)
  See anonymize.yaml for format reference and available converters.

EOF
)
